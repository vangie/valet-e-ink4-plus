# Overrides for the on-desk test build (tools/dev/build.sh). Applied on top of
# the committed sdkconfig; never used for a release image.

# Leave the touch controller's own firmware alone while testing.
# CONFIG_METALIO_TOUCH_UPGRADE_ON_BOOT is not set

# "@DEV" commands on the USB console: screenshots and injected input.
CONFIG_VALET_DEV_LINK=y

# Keep Info logs and error names on the desk (release drops them to save ~110 KB).
# CONFIG_LOG_DEFAULT_LEVEL_WARN is not set
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=y

# Log v2 stores tags and formats once: keeps the test image inside the 5 MB app
# partition with Info logs on (release keeps v1 at Warn level).
# CONFIG_LOG_VERSION_1 is not set
CONFIG_LOG_VERSION_2=y
